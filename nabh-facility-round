        <div style="margin-bottom:18px;"><label style="display:block;color:#7a9db8;font-size:13px;margin-bottom:5px;">Message *</label><textarea name="message" required rows="4" style="width:100%;box-sizing:border-box;padding:10px 12px;background:#0d2035;border:1px solid #1e3a52;border-radius:8px;color:#eef4f9;font-size:15px;outline:none;resize:vertical;font-family:inherit;"></textarea></div>
        <button type="submit" id="cSubmit" style="width:100%;padding:12px;background:#0E8A5F;border:none;border-radius:10px;color:#fff;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;">Send Message</button>
      </form>
    </div>
  </div>
  <script>
    document.getElementById('contactModal').addEventListener('click',function(e){if(e.target===this){this.style.display='none';document.getElementById('cSuccess').style.display='none';document.getElementById('cError').style.display='none';document.getElementById('cForm').reset();}});
    async function submitContact(e){
      e.preventDefault();var btn=document.getElementById('cSubmit');btn.disabled=true;btn.textContent='Sending…';
      document.getElementById('cSuccess').style.display='none';document.getElementById('cError').style.display='none';
      var f=e.target;
      try{var r=await fetch('https://api.web3forms.com/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({access_key:'2aaadfc3-c669-4b2b-92b8-6d6bee4faee1',name:f.name.value,email:f.email.value,phone:f.phone.value,message:f.message.value})});
        var j=await r.json();
        if(r.ok&&j.success){document.getElementById('cSuccess').style.display='block';f.reset();}
        else document.getElementById('cError').style.display='block';
      }catch(err){document.getElementById('cError').style.display='block';}
      btn.disabled=false;btn.textContent='Send Message';
    }
  </script>
</body>
</html>
