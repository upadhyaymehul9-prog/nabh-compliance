rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MVP: tighten before production — use Firebase Auth custom claims per role.
    // Start in test mode while building, then deploy these rules.

    match /clinics/{clinicId} {
      allow read: if true;
      allow write: if false;
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false;
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
